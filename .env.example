# Base de datos (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/layer"

# Auth.js (next-auth v5) — genera el tuyo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="genera-un-secreto-random-aca"

# Datos para pagar por transferencia (se muestran al cliente al confirmar el
# pedido; el pago se verifica manualmente desde el panel de administración,
# sin pasarela de pago ni comisión)
BANK_ALIAS="tu-alias"
BANK_CBU="0000000000000000000000"
BANK_HOLDER="Nombre Apellido"

# Email transaccional (confirmaciones de pedido, aviso a admins)
EMAIL_FROM="pedidos@layer.com"
RESEND_API_KEY=""

# Mail(es) de los dueños que reciben notificacion de pedido nuevo
ADMIN_NOTIFICATION_EMAILS="layer.impresion3d@gmail.com"

# Cuenta de administrador del panel (/admin) — se siembra automáticamente al
# arrancar el servidor si no existe todavía. Cambiá la contraseña acá y
# reiniciá el servidor para actualizarla.
ADMIN_EMAIL="admin@layer.com"
ADMIN_PASSWORD="cambiar-esta-password"

# WhatsApp de contacto (mostrados en el sitio)
NEXT_PUBLIC_WHATSAPP_NUMBER_1="5493534171487"
NEXT_PUBLIC_WHATSAPP_NUMBER_2="5493535186666"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/layer.vm"
