# Base de datos (Supabase Postgres)
# DATABASE_URL = transaction pooler (puerto 6543, con ?pgbouncer=true) — runtime de la app.
# DIRECT_URL   = session pooler / conexión directa (puerto 5432) — migraciones de Prisma.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Storage — fotos de producto. Dashboard: Project Settings → API.
# El bucket "product-images" (público) se crea solo la primera vez que se sube.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service_role-key-secreta"

# Auth.js (next-auth v5) — genera el tuyo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="genera-un-secreto-random-aca"
# Poner en "true" fuera de Vercel (self-host, `next start`, Docker) para que
# Auth.js confíe en el host de la request. En Vercel no hace falta.
AUTH_TRUST_HOST="true"

# Datos para pagar por transferencia (se muestran al cliente al confirmar el
# pedido; el pago se verifica manualmente desde el panel de administración,
# sin pasarela de pago ni comisión)
BANK_ALIAS="tu-alias"
BANK_CBU="0000000000000000000000"
BANK_HOLDER="Nombre Apellido"

# Email transaccional (confirmaciones de pedido, aviso a admins)
EMAIL_FROM="pedidos@layer.com"
RESEND_API_KEY=""

# Mail(es) de los dueños que reciben notificacion de pedido nuevo
ADMIN_NOTIFICATION_EMAILS="layer.impresion3d@gmail.com"

# Cuenta de administrador del panel (/admin) — se crea/actualiza en la base de
# datos la primera vez que alguien inicia sesión o se registra. Cambiá la
# contraseña acá y volvé a iniciar sesión para actualizarla.
ADMIN_EMAIL="admin@layer.com"
ADMIN_PASSWORD="cambiar-esta-password"

# WhatsApp de contacto (mostrados en el sitio)
NEXT_PUBLIC_WHATSAPP_NUMBER_1="5493534171487"
NEXT_PUBLIC_WHATSAPP_NUMBER_2="5493535186666"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/layer.vm"
